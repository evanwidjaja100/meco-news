# Create a bot with https://t.me/BotFather and keep this token secret.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_token

# Send /start to the bot, then run: python -m meco_news --discover-chat
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Optional overrides
# MECO_CONFIG=config/watchlist.json
# STATE_DB=data/meco_news.db
# LOG_LEVEL=INFO
# LOG_FILE=logs/meco_news.jsonl

# Emergency operational kill switch for automatic retries. Keep unset normally.
# MECO_DISABLE_RETRIES=1
